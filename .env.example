# Локальная модель (так работает демо): Ollama + qwen3:8b — бесплатно, данные не покидают компьютер
CQA_PROVIDER=ollama
CQA_MODEL=qwen3:8b
# qwen3 без режима рассуждения: ответ строго по схеме, быстрее
OLLAMA_THINK=false
OLLAMA_URL=http://localhost:11434
# Контекст в токенах; для 6 ГБ видеопамяти 12288 — оптимально
OLLAMA_NUM_CTX=12288
# Локальная модель на одной видеокарте — по одному диалогу
CQA_CONCURRENCY=1

# Облачная модель вместо локальной: раскомментируйте и закомментируйте блок выше
# CQA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CQA_MODEL=claude-opus-5-5
# CQA_EFFORT=high          # глубина рассуждений: low | medium | high | xhigh | max
# CQA_CONCURRENCY=4

# Число независимых прогонов на диалог (голосование большинством; >1 повышает стабильность и время)
CQA_RUNS=1
PORT=3000
# Адрес API организаторов без group_id — ссылка «Открыть GET для DEV» из гайда (содержит подпись, не публикуйте)
CQA_DATASET_API_URL=
# Название команды для results.json (формат организаторов)
CQA_TEAM_NAME=1DEA
