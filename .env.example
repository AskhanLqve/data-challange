# Облачная модель (по умолчанию): Claude через Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
CQA_PROVIDER=anthropic
CQA_MODEL=claude-opus-5-5
# Глубина рассуждений: low | medium | high | xhigh | max
CQA_EFFORT=high

# Локальная модель вместо облака:
# CQA_PROVIDER=ollama
# CQA_MODEL=qwen2.5:14b-instruct
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=12288   # контекст в токенах; для 6 ГБ видеопамяти 12288 — оптимально
# CQA_CONCURRENCY=1      # для локальной модели — по одному диалогу

# Число независимых прогонов на диалог (голосование большинством; >1 повышает стабильность и цену)
CQA_RUNS=1
# Параллельных оценок в пакете
CQA_CONCURRENCY=4
PORT=3000
# Адрес API организаторов без group_id (по умолчанию — из задания)
# CQA_DATASET_API_URL=
